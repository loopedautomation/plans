{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "platforms": ["linux", "macOS", "windows"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "notification:default",
    "core:window:allow-start-dragging",
    "updater:default",
    "process:allow-restart"
  ]
}
